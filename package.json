{
  "name": "notepadss",
  "version": "1.0.0",
  "description": "Notepad++ Style Text File Screenshot Tool with Windows 11 Snipping Tool",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npx electron .",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npx electron .\"",
    "desktop:build": "vite build && npx electron-builder",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "concurrently": "^9.1.2",
    "electron": "^45.3.4",
    "vite": "^8.3.8",
    "wait-on": "^8.0.2"
  }
}
