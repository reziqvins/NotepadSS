{
  "name": "notepadss",
  "version": "1.0.0",
  "description": "Notepad++ Style Text File Screenshot Tool with Windows 11 Snipping Tool",
  "author": "reziqvins <nreziq@gmail.com>",
  "desktopName": "NotepadSS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "npx electron .",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npx electron .\"",
    "desktop:build": "vite build && npx electron-builder",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "concurrently": "^9.1.2",
    "electron": "^45.3.4",
    "vite": "^8.3.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.notepadss.app",
    "productName": "TextShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app.ico",
      "app-icon-512.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "app-icon-512.png",
      "category": "Utility",
      "maintainer": "reziqvins <nreziq@gmail.com>"
    }
  }
}
